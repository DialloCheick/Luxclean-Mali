# GEMINI_API_KEY: used ONLY server-side by the Cloudflare Pages Function at
# functions/api/estimate-condition.ts (the AI photo dirt-estimator for the
# devis calculator). It is NEVER exposed to the browser.
#
# Get a key at https://aistudio.google.com/apikey (free tier is generous
# enough for a small business site).
#
# Where to actually set this: Cloudflare Pages dashboard -> your project ->
# Settings -> Environment variables -> add GEMINI_API_KEY as a SECRET for
# both Production and Preview. Do NOT put the real value in this file or
# commit it anywhere.
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional. Lets you bump the Gemini model used for photo analysis without a
# code change. Leave unset to use the default (gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"
